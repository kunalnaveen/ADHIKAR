rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection and subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /familyTrees/{treeId} {
        allow read, write: if isOwner(userId);
      }

      match /inheritanceReports/{reportId} {
        allow read, write: if isOwner(userId);
      }

      match /generatedDocuments/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /riskAssessments/{assessmentId} {
        allow read, write: if isOwner(userId);
      }

      match /peaceScores/{scoreId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}